# URL del backend (Desarrollador 1). Debe incluir el prefijo /api
VITE_API_URL=http://localhost:4000/api

# true = usa la API simulada con datos de demostración (localStorage).
# false = consume el backend real en VITE_API_URL.
VITE_USE_MOCK=true

# URL del repositorio público (Desarrollador 5), usada en el enlace "Ver sitio público"
VITE_PUBLIC_URL=http://localhost:5174
